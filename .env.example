# Buat nilai acak terpisah (hex minimal 32 byte); jangan gunakan contoh sebagai rahasia.
CHESSLAB_DB_PASSWORD=
CHESSLAB_RUNTIME_PASSWORD=
CHESSLAB_KEY_PEPPER=
CHESSLAB_SIGNING_KEY_FILE=./secrets/license-private.pem
CHESSLAB_SIGNING_KEY_ID=ed25519-2026-01
CHESSLAB_PUBLIC_ORIGIN=http://localhost:8080
# false hanya untuk pengujian localhost melalui HTTP. Produksi wajib true dan HTTPS.
CHESSLAB_SECURE_COOKIES=false
CHESSLAB_SITE_ADDRESS=http://:8080
